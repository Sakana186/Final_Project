# Service-specific overrides for api-gateway.
# This file is loaded after the repo root `.env`.
MEDCHAIN_GATEWAY_HOST=0.0.0.0
MEDCHAIN_GATEWAY_PORT=4001
MEDCHAIN_BLOCKCHAIN_SERVICE_URL=http://127.0.0.1:4100
MEDCHAIN_STORAGE_SERVICE_URL=http://127.0.0.1:4200

# Optional UI-only display name if you do not want to rely on the repo root `.env`.
MEDCHAIN_ADMIN_DISPLAY_NAME=Quản trị viên
