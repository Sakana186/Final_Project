# Service-specific overrides for storage-service.
# This file is loaded after the repo root `.env`.
MEDCHAIN_STORAGE_HOST=0.0.0.0
MEDCHAIN_STORAGE_PORT=4200

# Use `python3` for Docker or system Python.
# Override to `.venv/bin/python` if you prepared a local venv for the helper.
MEDCHAIN_PYTHON_BIN=python3

# Optional override. Leave empty in the normal repo layout because the helper can auto-detect
# the vendored Charm-Crypto runtime under `services/storage-service/python-vendor`.
MEDCHAIN_CHARM_SRC=

MEDCHAIN_LOCAL_PACKAGE_DIR=data/packages
MEDCHAIN_KPABE_CURVE=BN254
MEDCHAIN_KPABE_KEYSTORE_PATH=data/kpabe_keystore.json

# Optional Pinata integration. Leave empty to use LOCAL_FALLBACK mode.
PINATA_JWT=
PINATA_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
