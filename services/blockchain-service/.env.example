# Service-specific overrides for blockchain-service.
# This file is loaded after the repo root `.env`.
MEDCHAIN_BLOCKCHAIN_SERVICE_HOST=0.0.0.0
MEDCHAIN_BLOCKCHAIN_SERVICE_PORT=4100
MEDCHAIN_NETWORK=sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional override if you do not want to use `deployments/<network>.json`.
CONTRACT_ADDRESS=

# Optional backend signer for admin endpoints and Hardhat deployment.
# The default browser flow signs admin actions with MetaMask instead.
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=
