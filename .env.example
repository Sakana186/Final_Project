# Shared env loaded from the repo root.
# Individual service-level `.env` files, Docker Compose, or process env can override these values.
MEDCHAIN_NETWORK=sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: override the checked-in deployment file instead of using `deployments/sepolia.json`.
CONTRACT_ADDRESS=

# Optional backend signer for blockchain-service and Hardhat deployment.
# In the default UI flow, admin actions are signed by MetaMask in the browser.
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=

# Optional: turn on real Pinata uploads for storage-service.
# Leave empty to use LOCAL_FALLBACK mode.
PINATA_JWT=
PINATA_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs

# Optional UI-only display name for the admin account in api-gateway.
MEDCHAIN_ADMIN_DISPLAY_NAME=Quản trị viên
