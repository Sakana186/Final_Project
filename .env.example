MEDCHAIN_NETWORK=sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: override a pre-existing deployment instead of the checked-in sepolia.json
CONTRACT_ADDRESS=

# Required only if you want blockchain-service to sign admin writes from backend.
# In the default UI flow, admin actions are signed by MetaMask in the browser.
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=

# Optional: turn on real Pinata uploads. Leave empty to use LOCAL_FALLBACK mode.
PINATA_JWT=
PINATA_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs

MEDCHAIN_ADMIN_DISPLAY_NAME=Quản trị viên

